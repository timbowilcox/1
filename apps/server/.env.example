# ============================================================================
# RealStyler server environment. Validated at boot (src/config/environment.ts)
# — the server will REFUSE TO START if a required var is missing/invalid.
# Copy to .env for local dev; set these in your host's secret store for prod.
# ============================================================================

# --- Core ---
NODE_ENV=development                # development | test | production
PORT=4000
USE_MOCK_AI=true                    # true = mock provider (no real AI cost). MUST be false in prod.
SESSION_SECRET=                     # REQUIRED. Strong random string; >= 32 chars in production.
TRUST_PROXY=1                       # trusted proxy hops in front of the app (PaaS LB = 1)

# --- URLs / cookies ---
CLIENT_URL=http://localhost:3000    # REQUIRED. Exact origin of the web client (CORS + CSRF).
COOKIE_DOMAIN=                      # optional, e.g. .yourdomain.com to share cookie across app.*/api.*

# --- Database (Supabase Postgres) ---
DATABASE_URL=                       # REQUIRED. Pooler URL for runtime (add ?pgbouncer=true&connection_limit=N&sslmode=require)
# DIRECT_URL=                       # (Phase 4) direct connection for prisma migrate deploy

# --- Plans / quota ---
PLAN_LIMIT_FREE=3
PLAN_LIMIT_PRO=200
PLAN_LIMIT_PRO_PLUS=1000
FREE_PERIOD=30d                     # rolling free-quota window (ms-style duration)

# --- AI providers ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=
SD_API_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PRO_PLUS=
STRIPE_PORTAL_CONFIGURATION=

# --- Supabase storage ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # full-access service role — keep secret, rotate before launch
SUPABASE_BUCKET_NAME=

# --- Redis (sessions + jobs; REQUIRED in production) ---
REDIS_URL=                          # preferred: rediss://default:<pw>@host:port  (managed Redis)
REDIS_HOST=localhost                # fallback for local dev
REDIS_PORT=6379
