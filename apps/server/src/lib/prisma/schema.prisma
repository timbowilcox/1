generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String  @id @default(uuid())
  name             String
  email            String  @unique
  passwordHash     String  @map("password_hash")
  stripeCustomerId String? @map("stripe_customer_id")
  avatarUrl        String? @map("avatar_url")
  emailVerified    Boolean @default(false) @map("email_verified")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects      Project[]
  subscriptions Subscription[]
  usageTracking UsageTracking[]
  agentProfile  AgentProfile?
  tokens        AuthToken[]

  @@map("users")
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  type      AuthTokenType
  tokenHash String        @map("token_hash") // sha256 of the raw token
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("auth_tokens")
}

model AgentProfile {
  id          String  @id @default(uuid())
  userId      String  @unique @map("user_id")
  companyName String? @map("company_name")
  contactInfo String? @map("contact_info")
  logoUrl     String? @map("logo_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_profiles")
}

model Project {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  name        String
  address     String?
  stylePreset StylePreset? @map("style_preset")
  shareId     String?      @unique @map("share_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalImages OriginalProjectImage[]
  collections    Collection[]

  @@index([userId])
  @@map("projects")
}

model OriginalProjectImage {
  id        String @id @default(uuid())
  projectId String @map("project_id")

  originalPath String @map("original_url")
  orderIndex   Int    @map("order_index")
  width        Int?
  height       Int?

  createdAt DateTime @default(now()) @map("created_at")

  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  styledImages    StyledProjectImage[]
  collectionItems CollectionItem[]

  @@index([projectId])
  @@map("original_project_images")
}

model StyledProjectImage {
  id              String @id @default(uuid())
  originalImageId String @map("original_image_id")

  restyledPath String      @map("restyled_url")
  lighting     Lighting?
  creativity   Creativity?
  aesthetic    Aesthetic?
  width        Int?
  height       Int?

  createdAt DateTime @default(now()) @map("created_at")

  originalImage   OriginalProjectImage @relation(fields: [originalImageId], references: [id], onDelete: Cascade)
  collectionItems CollectionItem[]

  @@index([originalImageId])
  @@map("styled_project_images")
}

model Collection {
  id        String  @id @default(uuid())
  projectId String  @map("project_id")
  name      String
  shareId   String? @unique @map("share_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   CollectionItem[]

  @@index([projectId])
  @@map("collections")
}

model CollectionItem {
  id              String  @id @default(uuid())
  collectionId    String  @map("collection_id")
  originalImageId String? @map("original_image_id")
  styledImageId   String? @map("styled_image_id")
  orderIndex      Int     @map("order_index")

  createdAt DateTime @default(now()) @map("created_at")

  collection    Collection            @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  originalImage OriginalProjectImage? @relation(fields: [originalImageId], references: [id], onDelete: SetNull)
  styledImage   StyledProjectImage?   @relation(fields: [styledImageId], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([originalImageId])
  @@index([styledImageId])
  @@map("collection_items")
}

model Subscription {
  id     String @id @default(uuid())
  userId String @map("user_id")

  stripeSubscriptionId String             @unique @map("stripe_subscription_id")
  planTier             PlanTier           @map("plan_tier")
  status               SubscriptionStatus

  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

model UsageTracking {
  id      String  @id @default(uuid())
  userId  String? @map("user_id")
  guestId String? @map("guest_id")

  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  imagesUsed  Int @default(0) @map("images_used")
  imagesLimit Int @map("images_limit")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([guestId])
  @@map("usage_tracking")
}

model WebhookEvent {
  id          String   @id // Stripe event id — dedupe key for idempotency
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("webhook_events")
}

model Style {
  preset       StylePreset @id
  displayName  String      @map("display_name")
  description  String
  content      String 
  colorPalette String?     @map("color_palette")
  imageUrl     String?     @map("image_url")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("styles")
}

enum Lighting {
  NATURAL
  WARM
  AMBIENT
}

enum Creativity {
  SUBTLE
  BALANCED
  BOLD
}

enum Aesthetic {
  MODERN
  COASTAL
  MINIMAL
  JAPANDI
  INDUSTRIAL
  CLASSIC
  SCANDI
  BOHO
  RUSTIC
}

enum StylePreset {
  SCANDINAVIAN
  MINIMAL_LUXE
  MODERN_COASTAL
  JAPANDI
  BOLD_COLOUR
  URBAN_INDUSTRIAL
  HAMPTONS_CLASSIC
  MID_CENTURY_MODERN
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum PlanTier {
  PRO
  PRO_PLUS
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELED
  PAST_DUE
  UNPAID
  TRIALING
  INCOMPLETE
  INCOMPLETE_EXPIRED
}
